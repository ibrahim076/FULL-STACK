{
  "name": "contact-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Contact directory with a browser interface and a validated Express/Mongoose API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:postman": "node scripts/postman-check.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "mongoose": "^9.10.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  }
}
